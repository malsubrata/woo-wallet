{
    "name": "malsubrata/woo-wallet",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "description": "A powerful, extendable WooCommerce wallet system which support payment, partial payment, cashback reward program as well as refund for your WooCommerce store.",
    "homepage": "https://standalonetech.com/",
    "authors": [
        {
            "name": "Subrata Mal",
            "email": "m.subrata1991@gmail.com",
            "homepage": "https://github.com/malsubrata"
        }
    ],
    "keywords": [
        "wordpress",
        "woocommerce-wallet",
        "wallet",
        "wordpress-plugin"
    ],
    "support": {
        "issues": "https://github.com/malsubrata/woo-wallet/issues"
    },
    "require": {
        "php": ">=7.4",
        "composer/installers": "~1.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-phpunit/wp-phpunit": "dev-master",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}